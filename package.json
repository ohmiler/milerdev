{
  "name": "course-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/run-local-dev.cjs",
    "dev:remote": "infisical run --env=dev -- next dev",
    "dev:local": "infisical run --env=dev -- next dev",
    "build": "next build",
    "start": "npm run start:app",
    "lint": "eslint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:required": "playwright test --config=playwright.required.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "check:admin-text": "node scripts/check-admin-mojibake.mjs",
    "db:generate": "drizzle-kit generate",
    "db:preflight:oauth-accounts": "tsx scripts/check-oauth-account-duplicates.ts",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:migrate:local": "tsx src/lib/db/migrate.ts",
    "db:fixtures:e2e": "tsx scripts/create-e2e-fixtures.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs mysql",
    "docker:mysql": "docker exec -it milerdev-mysql mysql -uroot -proot milerdev",
    "start:app": "next start",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.5",
    "@paralleldrive/cuid2": "^3.0.6",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "argon2": "0.45.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.32.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.20.0",
    "sanitize-html": "2.17.7",
    "sonner": "^2.0.8",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
