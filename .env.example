# Local development only.
# Keep this pointed at your local MySQL instance.
# Do not put production or Railway credentials in .env.local.

# Database
DATABASE_URL="mysql://root:root@localhost:3306/milerdev"

# Authentication (NextAuth)
AUTH_SECRET=
# Server Actions (production/self-hosting)
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Stripe (Test Keys)
STRIPE_SECRET_KEY=         
STRIPE_WEBHOOK_SECRET=        

# Bunny.net
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_CDN_URL=
BUNNY_STREAM_TOKEN_KEY=

# SlipOK
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# Email (NodeMailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_LOGO_URL=

# App
NEXT_PUBLIC_APP_URL=
WP_DB_HOST=
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_NAME=
